
# ============================================================
# ML-07: BASELINE ACTION SCORE AND TOP-20 REVIEW
# FlyRank Internship - Refresh / Content Opportunity Scoring
# ============================================================

import pandas as pd
import numpy as np
import json

from pathlib import Path


# ============================================================
# 1. LOAD DATASET
# ============================================================

current_path = Path.cwd().resolve()

possible_roots = [
    current_path,
    current_path.parent,
    current_path.parent.parent,
    current_path.parent.parent.parent
]

project_root = None

for path in possible_roots:
    if (path / "data" / "raw").exists():
        project_root = path
        break

if project_root is None:
    raise FileNotFoundError(
        "Could not locate data/raw. Run from the project "
        "or update the dataset path."
    )

DATA_PATH = (
    project_root /
    "data" /
    "raw" /
    "content_refresh_anonymized.csv"
)

if not DATA_PATH.exists():
    raise FileNotFoundError(f"Dataset not found: {DATA_PATH}")

df = pd.read_csv(DATA_PATH)

print("=" * 65)
print("ML-07: BASELINE ACTION SCORE AND TOP-20 REVIEW")
print("=" * 65)

print("\nDataset shape:", df.shape)
print("\nAvailable columns:")
print(df.columns.tolist())

display(df.head())


# ============================================================
# 2. IDENTIFY DATASET COLUMNS
# ============================================================

COLUMN_CANDIDATES = {
    "content_id": [
        "content_id", "url_id", "page_id", "item_id"
    ],
    "staleness": [
        "days_since_last_update",
        "days_since_update",
        "content_age_days",
        "days_old",
        "staleness_days"
    ],
    "impressions": [
        "impressions_90d",
        "impressions",
        "total_impressions"
    ],
    "clicks": [
        "clicks_90d",
        "clicks",
        "total_clicks"
    ],
    "ctr": [
        "ctr_90d",
        "ctr",
        "click_through_rate"
    ],
    "position": [
        "avg_position_90d",
        "avg_position",
        "average_position",
        "position"
    ]
}

COL = {}

for key, candidates in COLUMN_CANDIDATES.items():
    COL[key] = next(
        (column for column in candidates if column in df.columns),
        None
    )

print("\nDetected columns:")

for key, value in COL.items():
    print(f"{key}: {value}")

required_fields = [
    "staleness",
    "impressions",
    "position"
]

missing_fields = [
    field for field in required_fields
    if COL[field] is None
]

if missing_fields:
    raise ValueError(
        f"Missing required fields: {missing_fields}. "
        "Update COLUMN_CANDIDATES using the actual CSV columns."
    )

if COL["content_id"] is None:
    df["baseline_content_id"] = df.index.astype(str)
    COL["content_id"] = "baseline_content_id"


# ============================================================
# 3. PREPARE NUMERIC DATA
# ============================================================

for field in ["staleness", "impressions", "clicks", "ctr", "position"]:

    column = COL[field]

    if column is not None:
        df[column] = pd.to_numeric(
            df[column],
            errors="coerce"
        )

if COL["ctr"] is None:

    if COL["clicks"] is None:
        raise ValueError(
            "Neither CTR nor clicks is available."
        )

    df["calculated_ctr"] = (
        df[COL["clicks"]] /
        df[COL["impressions"]].replace(0, np.nan)
    ) * 100

    COL["ctr"] = "calculated_ctr"

valid_ctr = df[COL["ctr"]].dropna()

if len(valid_ctr) > 0 and valid_ctr.median() <= 1:
    df[COL["ctr"]] = df[COL["ctr"]] * 100

print("\nCTR summary:")
display(df[COL["ctr"]].describe())


# ============================================================
# 4. CREATE SIGNAL BUCKETS
# ============================================================

df["staleness_bucket"] = pd.cut(
    df[COL["staleness"]],
    bins=[-np.inf, 30, 90, 180, 365, np.inf],
    labels=[
        "0-30 days",
        "31-90 days",
        "91-180 days",
        "181-365 days",
        "365+ days"
    ]
)

df["position_bucket"] = pd.cut(
    df[COL["position"]],
    bins=[0, 3, 10, 20, 50, np.inf],
    labels=[
        "Top 3",
        "4-10",
        "11-20",
        "21-50",
        "50+"
    ]
)


# ============================================================
# 5. SIGNAL 1: STALENESS AUDIT
# ============================================================

flag_candidates = [
    column for column in df.columns
    if any(
        term in column.lower()
        for term in [
            "refresh_flag",
            "is_refresh",
            "stale_flag",
            "refresh",
            "quick_win",
            "ctr_fix"
        ]
    )
]

print("\nPossible product flag columns:")
print(flag_candidates)

# Verify this selection against the dataset documentation.
FLAG_COL = flag_candidates[0] if flag_candidates else None

if FLAG_COL is not None:

    flag_values = df[FLAG_COL]

    if pd.api.types.is_bool_dtype(flag_values):
        df["audit_flag_positive"] = flag_values.astype(float)

    elif pd.api.types.is_numeric_dtype(flag_values):
        df["audit_flag_positive"] = (
            flag_values.fillna(0) > 0
        ).astype(float)

    else:
        positive_values = {
            "true", "yes", "1", "refresh",
            "quick_win", "ctr_fix", "positive"
        }

        df["audit_flag_positive"] = (
            flag_values.astype(str)
            .str.strip()
            .str.lower()
            .isin(positive_values)
            .astype(float)
        )

    signal_1 = df.groupby(
        "staleness_bucket",
        observed=False
    ).agg(
        n=(COL["content_id"], "count"),
        median_staleness=(COL["staleness"], "median"),
        flag_rate=("audit_flag_positive", "mean")
    ).reset_index()

    signal_1["flag_rate_pct"] = signal_1["flag_rate"] * 100

    print("\nSIGNAL 1: STALENESS VS PRODUCT FLAG")
    display(signal_1)

    valid_signal = signal_1.dropna(
        subset=["median_staleness", "flag_rate"]
    )

    if len(valid_signal) >= 2:

        correlation_1 = valid_signal[
            "median_staleness"
        ].corr(
            valid_signal["flag_rate"],
            method="spearman"
        )

        if correlation_1 >= 0.30:
            signal_1_verdict = "CONFIRMED"
        elif correlation_1 <= -0.30:
            signal_1_verdict = "OPPOSITE"
        else:
            signal_1_verdict = "MIXED"

    else:
        correlation_1 = np.nan
        signal_1_verdict = "FALSE"

    print("Signal 1 verdict:", signal_1_verdict)

else:

    print(
        "\nNo identifiable refresh-related flag found. "
        "Using CTR by staleness as a proxy, not as "
        "validation of a product flag."
    )

    signal_1 = df.groupby(
        "staleness_bucket",
        observed=False
    ).agg(
        n=(COL["content_id"], "count"),
        median_staleness=(COL["staleness"], "median"),
        median_ctr=(COL["ctr"], "median")
    ).reset_index()

    print("\nSIGNAL 1: STALENESS VS CTR PROXY")
    display(signal_1)

    valid_signal = signal_1.dropna(
        subset=["median_staleness", "median_ctr"]
    )

    if len(valid_signal) >= 2:

        correlation_1 = valid_signal[
            "median_staleness"
        ].corr(
            valid_signal["median_ctr"],
            method="spearman"
        )

        if correlation_1 <= -0.30:
            signal_1_verdict = "CONFIRMED"
        elif correlation_1 >= 0.30:
            signal_1_verdict = "OPPOSITE"
        else:
            signal_1_verdict = "MIXED"

    else:
        correlation_1 = np.nan
        signal_1_verdict = "FALSE"

    print("Signal 1 proxy verdict:", signal_1_verdict)


# ============================================================
# 6. SIGNAL 2: CTR VS SEARCH POSITION
# ============================================================

signal_2 = df.groupby(
    "position_bucket",
    observed=False
).agg(
    n=(COL["content_id"], "count"),
    median_position=(COL["position"], "median"),
    median_ctr=(COL["ctr"], "median")
).reset_index()

print("\nSIGNAL 2: CTR VS SEARCH POSITION")
display(signal_2)

valid_signal_2 = signal_2.dropna(
    subset=["median_position", "median_ctr"]
)

if len(valid_signal_2) >= 2:

    correlation_2 = valid_signal_2[
        "median_position"
    ].corr(
        valid_signal_2["median_ctr"],
        method="spearman"
    )

    if correlation_2 <= -0.30:
        signal_2_verdict = "CONFIRMED"
    elif correlation_2 >= 0.30:
        signal_2_verdict = "OPPOSITE"
    else:
        signal_2_verdict = "MIXED"

else:
    correlation_2 = np.nan
    signal_2_verdict = "FALSE"

print("Signal 2 verdict:", signal_2_verdict)
print("Spearman correlation:", correlation_2)


# ============================================================
# 7. BUILD BASELINE ACTION SCORE
# ============================================================

score_df = df.copy()

# Historical inputs only.
scoring_columns = [
    COL["content_id"],
    COL["staleness"],
    COL["impressions"],
    COL["ctr"],
    COL["position"]
]

print("\nScoring input columns:")
print(scoring_columns)

# Peer CTR by position bucket.
score_df["peer_ctr"] = score_df.groupby(
    "position_bucket",
    observed=False
)[COL["ctr"]].transform("median")

# Positive gap means actual CTR is below peer median.
score_df["ctr_gap"] = (
    score_df["peer_ctr"] - score_df[COL["ctr"]]
).clip(lower=0)

# Baseline eligibility.
eligible = (
    (score_df[COL["staleness"]] >= 180) &
    (score_df[COL["impressions"]] >= 300) &
    (score_df[COL["position"]] > 0) &
    (score_df[COL["ctr"]].notna()) &
    (score_df["peer_ctr"].notna()) &
    (score_df["ctr_gap"] > 0)
)

# One reason code and one action label.
score_df["action"] = "MONITOR"
score_df["reason_code"] = "NOT_SELECTED"

score_df.loc[eligible, "action"] = "REFRESH"
score_df.loc[eligible, "reason_code"] = (
    "STALE_VISIBLE_CTR_GAP"
)

# Score = CTR gap * log(1 + impressions).
score_df["baseline_score"] = (
    score_df["ctr_gap"] *
    np.log1p(
        score_df[COL["impressions"]].clip(lower=0)
    )
)

score_df.loc[~eligible, "baseline_score"] = 0

score_df["baseline_score"] = (
    score_df["baseline_score"]
    .replace([np.inf, -np.inf], np.nan)
    .fillna(0)
)

# Rank all content.
score_df = score_df.sort_values(
    by="baseline_score",
    ascending=False
).reset_index(drop=True)

score_df["rank"] = np.arange(
    1, len(score_df) + 1
)


# ============================================================
# 8. WRITE RANKED QUEUE CSV
# ============================================================

output_columns = [
    "rank",
    COL["content_id"],
    COL["staleness"],
    COL["impressions"],
    COL["ctr"],
    COL["position"],
    "position_bucket",
    "peer_ctr",
    "ctr_gap",
    "baseline_score",
    "reason_code",
    "action"
]

baseline_queue = score_df[output_columns].copy()

output_dir = project_root / "work" / "outputs"
output_dir.mkdir(parents=True, exist_ok=True)

output_path = output_dir / "baseline_action_score.csv"

baseline_queue.to_csv(
    output_path,
    index=False
)

print("\nBASELINE QUEUE CREATED")
print("Output:", output_path)
print("Total content:", len(baseline_queue))

print("\nAction distribution:")
display(
    baseline_queue["action"].value_counts().to_frame("count")
)

print("\nTop 20 ranked content:")
display(baseline_queue.head(20))


# ============================================================
# 9. TOP-20 REVIEW
# ============================================================

top_20 = score_df[
    score_df["baseline_score"] > 0
].head(20).copy()

bucket_counts = score_df[
    "position_bucket"
].value_counts(observed=False)

review_rows = []

for _, row in top_20.iterrows():

    bucket = row["position_bucket"]

    if pd.isna(bucket):
        bucket_n = 0
    else:
        bucket_n = int(bucket_counts.get(bucket, 0))

    if bucket_n >= 30:
        confidence = "HIGH"
    elif bucket_n >= 10:
        confidence = "MEDIUM"
    else:
        confidence = "LOW"

    review_rows.append({
        "rank": int(row["rank"]),
        "content_id": row[COL["content_id"]],
        "action": row["action"],
        "reason_code": row["reason_code"],
        "baseline_score": round(
            row["baseline_score"], 3
        ),
        "confidence": confidence,
        "peer_group_n": bucket_n,
        "why_selected": (
            f"Staleness: {row[COL['staleness']]} days; "
            f"impressions: {row[COL['impressions']]}; "
            f"CTR: {round(row[COL['ctr']], 3)}; "
            f"peer median CTR: {round(row['peer_ctr'], 3)}."
        ),
        "what_could_make_it_wrong": (
            "Seasonality, search-intent differences, tracking errors, "
            "recent content changes, or an unrepresentative peer group."
        )
    })

top_20_review = pd.DataFrame(review_rows)

print("\nTOP-20 REVIEW")
print("Recommendations reviewed:", len(top_20_review))

if len(top_20_review) > 0:
    display(top_20_review)
else:
    print("No positive-score recommendations were found.")

review_path = output_dir / "w04_top20_review.csv"

top_20_review.to_csv(
    review_path,
    index=False
)

print("Top-20 review saved:", review_path)


# ============================================================
# 10. WEAK PICKS ANALYSIS
# ============================================================

refresh_picks = score_df[
    score_df["action"] == "REFRESH"
].copy()

weak_picks = refresh_picks[
    (
        refresh_picks["peer_ctr"].isna()
    ) |
    (
        refresh_picks["position_bucket"].isna()
    ) |
    (
        refresh_picks["position_bucket"]
        .map(bucket_counts)
        .fillna(0) < 10
    )
].copy()

print("\nWEAK PICKS ANALYSIS")
print("Total refresh recommendations:", len(refresh_picks))
print("Potentially weak recommendations:", len(weak_picks))

if len(weak_picks) > 0:

    weak_picks["weak_pick_reason"] = (
        "Limited supporting observations in position peer group"
    )

    display(
        weak_picks[
            [
                "rank",
                COL["content_id"],
                "baseline_score",
                "position_bucket",
                "peer_ctr",
                "reason_code",
                "weak_pick_reason"
            ]
        ].head(20)
    )

else:
    print("No weak recommendations identified by this check.")


# ============================================================
# 11. LEAKAGE CHECK
# ============================================================

suspicious_patterns = [
    "future",
    "next_period",
    "next_month",
    "next_quarter",
    "next_year",
    "conversion_after",
    "outcome",
    "target",
    "label"
]

suspicious_columns = []

for column in df.columns:

    if any(
        pattern in column.lower()
        for pattern in suspicious_patterns
    ):
        suspicious_columns.append(column)

print("\nLEAKAGE CHECK")

if suspicious_columns:
    print("Columns requiring manual review:")
    print(suspicious_columns)
else:
    print("No suspicious column names detected.")

print("\nScoring inputs:")

for column in scoring_columns:
    print("-", column)

leakage_in_scoring = [
    column for column in scoring_columns
    if any(
        pattern in column.lower()
        for pattern in suspicious_patterns
    )
]

print("\nPotential leakage in scoring inputs:")
print(leakage_in_scoring)

if FLAG_COL is not None:
    print("\nProduct flag used for audit only:", FLAG_COL)
    print(
        "Product flag included in scoring inputs:",
        FLAG_COL in scoring_columns
    )


# ============================================================
# 12. SAVE METRICS JSON
# ============================================================

metrics = {
    "dataset_rows": int(len(df)),
    "dataset_columns": int(len(df.columns)),
    "refresh_recommendations": int(len(refresh_picks)),
    "monitor_recommendations": int(
        (score_df["action"] == "MONITOR").sum()
    ),
    "weak_recommendations": int(len(weak_picks)),
    "top20_reviewed": int(len(top_20_review)),
    "signal_1_verdict": signal_1_verdict,
    "signal_2_verdict": signal_2_verdict,
    "refresh_flag_column": FLAG_COL,
    "scoring_inputs": scoring_columns,
    "potentially_suspicious_columns": suspicious_columns,
    "potential_leakage_in_scoring_inputs": leakage_in_scoring,
    "reason_code": "STALE_VISIBLE_CTR_GAP",
    "refresh_action": "REFRESH",
    "default_action": "MONITOR"
}

metrics_path = output_dir / "w04_baseline_metrics.json"

with open(metrics_path, "w") as file:
    json.dump(metrics, file, indent=4)

print("\nMetrics saved:", metrics_path)


# ============================================================
# 13. FINAL SELF-CHECK
# ============================================================

checks = {
    "Dataset loaded": len(df) > 0,
    "Signal 1 audited": signal_1 is not None,
    "Signal 2 audited": signal_2 is not None,
    "Baseline score generated": "baseline_score" in score_df.columns,
    "Rank generated": "rank" in score_df.columns,
    "Reason code generated": "reason_code" in score_df.columns,
    "Action generated": "action" in score_df.columns,
    "Baseline CSV saved": output_path.exists(),
    "Top-20 review saved": review_path.exists(),
    "Metrics JSON saved": metrics_path.exists()
}

print("\n" + "=" * 65)
print("FINAL SELF-CHECK")
print("=" * 65)

for check, result in checks.items():
    print(f"{'[PASS]' if result else '[FAIL]'} {check}")

print("\nGenerated files:")
print(output_path)
print(review_path)
print(metrics_path)

print("\nML-07 execution completed.")
